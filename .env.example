# Optional: persistent directory on a long-running Node host.
# Defaults to .cache/menus. Mount durable storage for production.
# MENU_DATA_DIR=/data/obedy

# Needed only for remote operator refresh/status endpoints (at least 16 characters).
# CRON_SECRET=

# Optional: authenticated Jina browser rendering and managed proxy for Dulak.
# Without a key, the app still attempts normal keyless HTML retrieval.
# Server-only; never use a NEXT_PUBLIC_ credential.
# JINA_API_KEY=
